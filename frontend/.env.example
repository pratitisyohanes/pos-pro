# ==============================================================
# API (relative paths; Vite proxy in dev and Nginx in production forward them)
# ==============================================================
# pos-api routes
VITE_API_URL=/api/v1
# Login, refresh and profile routes of booking-api (fin-pro)
VITE_AUTH_URL=/auth

# ==============================================================
# Integration
# ==============================================================
# Booking app, used for "Book installation" and "Sign up" links
VITE_BOOKING_URL=http://localhost:5173
# VITE_BOOKING_URL=https://booking.pratitis.net

# ==============================================================
# Dev proxy targets (only read by vite.config.js, never sent to the browser)
# ==============================================================
DEV_POS_API_TARGET=http://localhost:5001
DEV_BOOKING_API_TARGET=http://localhost:5000
