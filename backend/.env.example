# ==============================================================
# Application
# ==============================================================
# development | test | production
NODE_ENV=development
# Port the Express API listens on (booking-api uses 5000)
PORT=5001

# ==============================================================
# Database (PostgreSQL)
# ==============================================================
# DB local: same PostgreSQL server as booking, separate database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pos_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
# true only for hosted databases that require SSL
DB_SSL=false

# # DB production (VPS)
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=pos_db
# DB_USERNAME=pos_user
# DB_PASSWORD=change-me

# Alternative: one connection string; when set it overrides every DB_* value above
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_db

# ==============================================================
# Integration with booking-api (fin-pro)
# ==============================================================
# Copy JWT_ACCESS_SECRET from fin-pro/backend/.env; accounts and tokens come from booking-api
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
# Base URL of booking-api; on the VPS keep 127.0.0.1 so calls never leave the server
BOOKING_API_URL=http://127.0.0.1:5000/api/v1
# Same value as INTERNAL_API_KEY in fin-pro/backend/.env (min 32 chars)
INTERNAL_API_KEY=change-me-internal-key-at-least-32-characters
# Give up on booking-api after this many milliseconds
BOOKING_TIMEOUT_MS=3000

# ==============================================================
# Security
# ==============================================================
# Frontend origins allowed to call the API, comma separated
CORS_ORIGIN=http://localhost:5174

# ==============================================================
# Single sign-on (KandangID, sso-pro) - leave empty to accept only booking-api tokens
# ==============================================================
# Public keys for RS256 tokens; on the VPS keep 127.0.0.1
# SSO_JWKS_URL=http://127.0.0.1:5002/.well-known/jwks.json
# Must equal PUBLIC_URL of sso-pro
# SSO_ISSUER=http://localhost:5002
SSO_AUDIENCE=pos-api
